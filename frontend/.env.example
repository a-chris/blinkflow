# Copy to .env.local (gitignored) and set only what you need.
#
# Extra hostnames the dev server accepts besides localhost, comma separated.
# Use it for a tunnel (ngrok, cloudflared, tailscale) or a LAN name.
# BLINKFLOW_ALLOWED_HOSTS=dev.example.com
#
# Where embedded share links point.
# The editor is often served from a different origin than the card server; set this when that origin is not localhost:8080.
# BLINKFLOW_SERVER_ORIGIN=https://blinkflow.example.com
#
# The card server's port, when it is not 8080.
# BLINKFLOW_SERVER_PORT=8080
